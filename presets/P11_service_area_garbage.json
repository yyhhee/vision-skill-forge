{
  "version": "0.1",
  "name": "service_area_garbage",
  "display_name": "服务区垃圾",
  "original_instruction": "检测服务区垃圾堆或散落废弃物。",
  "compile_status": "compiled",
  "input": {
    "accept": [
      "image"
    ]
  },
  "nodes": [
    {
      "id": "image",
      "op": "media.image@1.0",
      "inputs": {
        "media": "$input"
      },
      "params": {}
    },
    {
      "id": "resized",
      "op": "image.resize@1.0",
      "inputs": {
        "frames": "$image"
      },
      "params": {
        "mode": "long_side",
        "long_side": 1280
      }
    },
    {
      "id": "objects",
      "op": "rex.ground@1.0",
      "inputs": {
        "frames": "$resized"
      },
      "params": {
        "targets": [
          {
            "label": "垃圾",
            "phrases": [
              "garbage",
              "pile of trash",
              "scattered waste"
            ]
          }
        ]
      }
    },
    {
      "id": "draw",
      "op": "output.draw@1.0",
      "inputs": {
        "frames": "$image",
        "objects": "$objects"
      },
      "params": {}
    }
  ],
  "outputs": {
    "media": "$draw",
    "objects": "$objects"
  }
}