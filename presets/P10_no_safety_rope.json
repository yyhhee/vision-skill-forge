{
  "version": "0.1",
  "name": "no_safety_rope",
  "display_name": "未系安全绳",
  "original_instruction": "检测高处作业中没有连接安全绳或安全带的人员。",
  "compile_status": "compiled",
  "input": {
    "accept": [
      "image"
    ]
  },
  "nodes": [
    {
      "id": "image",
      "op": "media.image@1.0",
      "inputs": {
        "media": "$input"
      },
      "params": {}
    },
    {
      "id": "resized",
      "op": "image.resize@1.0",
      "inputs": {
        "frames": "$image"
      },
      "params": {
        "mode": "long_side",
        "long_side": 1280
      }
    },
    {
      "id": "objects",
      "op": "rex.ground@1.0",
      "inputs": {
        "frames": "$resized"
      },
      "params": {
        "targets": [
          {
            "label": "未系安全绳人员",
            "phrases": [
              "worker at height without safety harness",
              "person not attached to safety rope"
            ]
          }
        ]
      }
    },
    {
      "id": "draw",
      "op": "output.draw@1.0",
      "inputs": {
        "frames": "$image",
        "objects": "$objects"
      },
      "params": {}
    }
  ],
  "outputs": {
    "media": "$draw",
    "objects": "$objects"
  }
}