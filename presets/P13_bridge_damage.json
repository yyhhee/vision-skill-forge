{
  "version": "0.1",
  "name": "bridge_damage",
  "display_name": "桥梁病害",
  "original_instruction": "检测桥梁裂纹、锈蚀、渗水、剥落和露筋。",
  "compile_status": "compiled",
  "input": {
    "accept": [
      "image"
    ]
  },
  "nodes": [
    {
      "id": "image",
      "op": "media.image@1.0",
      "inputs": {
        "media": "$input"
      },
      "params": {}
    },
    {
      "id": "resized",
      "op": "image.resize@1.0",
      "inputs": {
        "frames": "$image"
      },
      "params": {
        "mode": "long_side",
        "long_side": 1280
      }
    },
    {
      "id": "tiled",
      "op": "image.tile@1.0",
      "inputs": {
        "frames": "$resized"
      },
      "params": {
        "tile_width": 640,
        "tile_height": 640,
        "overlap": 0.2,
        "deduplicate_iou": 0.7,
        "deduplicate_mode": "keep_larger"
      }
    },
    {
      "id": "objects",
      "op": "rex.ground@1.0",
      "inputs": {
        "frames": "$tiled"
      },
      "params": {
        "targets": [
          {
            "label": "裂纹",
            "phrases": [
              "bridge crack",
              "concrete crack"
            ]
          },
          {
            "label": "锈蚀",
            "phrases": [
              "bridge corrosion",
              "rust"
            ]
          },
          {
            "label": "渗水",
            "phrases": [
              "water seepage",
              "water stain"
            ]
          },
          {
            "label": "剥落",
            "phrases": [
              "concrete spalling",
              "exposed rebar"
            ]
          }
        ]
      }
    },
    {
      "id": "draw",
      "op": "output.draw@1.0",
      "inputs": {
        "frames": "$image",
        "objects": "$objects"
      },
      "params": {}
    }
  ],
  "outputs": {
    "media": "$draw",
    "objects": "$objects"
  }
}