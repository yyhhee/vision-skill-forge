{
  "version": "0.1",
  "name": "illegal_parking",
  "display_name": "车辆违停",
  "original_instruction": "检测持续静止超过1秒的车辆。",
  "compile_status": "compiled",
  "input": {
    "accept": [
      "video"
    ]
  },
  "nodes": [
    {
      "id": "video",
      "op": "media.video@1.0",
      "inputs": {
        "media": "$input"
      },
      "params": {}
    },
    {
      "id": "frames",
      "op": "video.sample@1.0",
      "inputs": {
        "video": "$video"
      },
      "params": {
        "mode": "fps",
        "fps": 2.0
      }
    },
    {
      "id": "vehicles",
      "op": "rex.ground@1.0",
      "inputs": {
        "frames": "$frames"
      },
      "params": {
        "targets": [
          {
            "label": "车辆",
            "phrases": [
              "parked vehicle",
              "vehicle"
            ]
          }
        ]
      }
    },
    {
      "id": "tracks",
      "op": "track.iou@1.0",
      "inputs": {
        "objects": "$vehicles"
      },
      "params": {}
    },
    {
      "id": "speed",
      "op": "measure.speed@1.0",
      "inputs": {
        "tracks": "$tracks"
      },
      "params": {
        "window_frames": 2
      }
    },
    {
      "id": "stopped",
      "op": "logic.compare@1.0",
      "inputs": {
        "left": "$speed"
      },
      "params": {
        "operator": "<",
        "value": 2.0
      }
    },
    {
      "id": "events",
      "op": "temporal.persist@1.0",
      "inputs": {
        "condition": "$stopped"
      },
      "params": {
        "seconds": 1.0,
        "scope": "track",
        "gap_tolerance_seconds": 0.6
      }
    },
    {
      "id": "alerts",
      "op": "output.alert@1.0",
      "inputs": {
        "events": "$events"
      },
      "params": {
        "label": "车辆违停"
      }
    },
    {
      "id": "draw",
      "op": "output.draw@1.0",
      "inputs": {
        "frames": "$frames",
        "objects": "$vehicles",
        "events": "$alerts"
      },
      "params": {}
    }
  ],
  "outputs": {
    "media": "$draw",
    "events": "$alerts",
    "objects": "$vehicles"
  }
}