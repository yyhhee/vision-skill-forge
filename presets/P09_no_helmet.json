{
  "version": "0.1",
  "name": "no_helmet",
  "display_name": "施工未戴安全帽",
  "original_instruction": "检测施工人员中没有佩戴安全帽的人。",
  "compile_status": "compiled",
  "input": {
    "accept": [
      "image"
    ]
  },
  "nodes": [
    {
      "id": "image",
      "op": "media.image@1.0",
      "inputs": {
        "media": "$input"
      },
      "params": {}
    },
    {
      "id": "resized",
      "op": "image.resize@1.0",
      "inputs": {
        "frames": "$image"
      },
      "params": {
        "mode": "long_side",
        "long_side": 1280
      }
    },
    {
      "id": "workers",
      "op": "rex.ground@1.0",
      "inputs": {
        "frames": "$resized"
      },
      "params": {
        "targets": [
          {
            "label": "施工人员",
            "phrases": [
              "construction worker"
            ]
          }
        ]
      }
    },
    {
      "id": "helmets",
      "op": "rex.ground@1.0",
      "inputs": {
        "frames": "$resized"
      },
      "params": {
        "targets": [
          {
            "label": "安全帽",
            "phrases": [
              "safety helmet"
            ]
          }
        ]
      }
    },
    {
      "id": "has_helmet",
      "op": "spatial.associate@1.0",
      "inputs": {
        "subjects": "$workers",
        "objects": "$helmets"
      },
      "params": {
        "relation": "center_in_subject_region",
        "threshold": 0.0,
        "subject_region": [
          0.0,
          0.0,
          1.0,
          0.35
        ]
      }
    },
    {
      "id": "no_helmet",
      "op": "logic.not@1.0",
      "inputs": {
        "condition": "$has_helmet"
      },
      "params": {}
    },
    {
      "id": "filtered",
      "op": "filter.apply@1.0",
      "inputs": {
        "objects": "$workers",
        "condition": "$no_helmet"
      },
      "params": {
        "output_label": "未戴安全帽人员"
      }
    },
    {
      "id": "draw",
      "op": "output.draw@1.0",
      "inputs": {
        "frames": "$image",
        "objects": "$filtered"
      },
      "params": {}
    }
  ],
  "outputs": {
    "media": "$draw",
    "objects": "$filtered"
  }
}