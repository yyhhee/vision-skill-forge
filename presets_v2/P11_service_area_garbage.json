            "relation": "source_entity",
            "threshold": 0.0
          },
          "enabled": true
        },
        {
          "id": "context_confirmation_confirmed",
          "op": "filter.apply@1.0",
          "inputs": {
            "objects": "$context_confirmation_candidates",
            "condition": "$context_confirmation_matches"
          },
          "params": {},
          "enabled": true
        },
        {
          "id": "context_confirmation_merged",
          "op": "objects.merge@1.0",
          "inputs": {
            "objects": [
              "$context_confirmation_unverified",
              "$context_confirmation_confirmed"
            ]
          },
          "params": {},
          "enabled": true
        },
        {
          "id": "context_confirmation_deduplicated",
          "op": "objects.deduplicate@1.0",
          "inputs": {
            "objects": "$context_confirmation_merged"
          },
          "params": {
            "metric": "ios",
            "threshold": 0.5,
            "keep": "first"
          },
          "enabled": true
        },
        {
          "id": "result_tracks",
          "op": "track.iou@1.0",
          "inputs": {
            "objects": "$context_confirmation_deduplicated"
          },
          "params": {
            "iou_threshold": 0.2,
            "max_missing_frames": 1,
            "same_label_only": true
          },
          "enabled": true
        },
        {
          "id": "confirmed_tracks",
          "op": "track.confirm@1.0",
          "inputs": {
            "tracks": "$result_tracks"
          },
          "params": {
            "min_hits": 2,
            "min_span_seconds": 0.5
          },
          "enabled": true
        },
        {
          "id": "confirmed_objects",
          "op": "objects.from_tracks@1.0",
          "inputs": {
            "tracks": "$confirmed_tracks"
          },
          "params": {
            "selection": "all"
          },
          "enabled": true
        },
        {
          "id": "count",
          "op": "measure.count@1.0",
          "inputs": {
            "entities": "$confirmed_tracks"
          },
          "params": {
            "scope": "unique",
            "group_by": "label"
          },
          "enabled": true
        },
        {
          "id": "draw",
          "op": "output.draw@1.0",
          "inputs": {
            "frames": "$resized",
            "objects": "$confirmed_tracks",
            "measurements": "$count"
          },
          "params": {
            "show_labels": true,
            "show_track_id": true,
            "show_trajectory": true
          },
          "enabled": true
        }
      ],
      "outputs": {
        "media": "$draw",
        "objects": "$confirmed_objects",
        "tracks": "$confirmed_tracks",
        "measurements": "$count"
      },
      "atom_bindings": {
        "atom_1": [
          "garbage_exclusion_1_exclusion_raw",
          "garbage_exclusion_1_exclusion",
          "garbage_exclusion_1_matches",
          "garbage_exclusion_1_not",
          "garbage_exclusion_1_filtered"
        ]
      },
      "configuration_slots": [],
      "issue": null
    }
