  "variants": {
    "video": {
      "media_type": "video",
      "status": "executable",
      "nodes": [
        {
          "id": "media",
          "op": "media.video@1.0",
          "inputs": {
            "media": "$input"
          },
          "params": {},
          "enabled": true
        },
        {
          "id": "frames",
          "op": "video.sample@1.1",
          "inputs": {
            "video": "$media"
          },
          "params": {
            "mode": "fps",
            "fps": 1.0
          },
          "enabled": true
        },
        {
          "id": "resized",
          "op": "image.resize@1.1",
          "inputs": {
            "frames": "$frames"
          },
          "params": {
            "mode": "long_side",
            "long_side": 1280
          },
          "enabled": true
        },
        {
          "id": "tiles",
          "op": "image.tile@1.1",
          "inputs": {
            "frames": "$resized"
          },
          "params": {
            "tile_width": 512,
            "tile_height": 512,
            "overlap_x": 0.25,
            "overlap_y": 0.25,
            "include_full_frame": true
          },
          "enabled": true
        },
        {
          "id": "vehicles_raw",
          "op": "rex.ground@1.1",
          "inputs": {
            "frames": "$tiles"
          },
          "params": {
            "targets": [
              {
                "label": "车辆",
                "phrases": [
                  "vehicle",
                  "car",
                  "passenger car",
                  "SUV",
                  "van",
                  "truck",
                  "bus"
                ]
              }
            ]
          },
          "enabled": true
        },
        {
          "id": "vehicles",
          "op": "objects.deduplicate@1.0",
          "inputs": {
            "objects": "$vehicles_raw"
          },
          "params": {
            "metric": "ios",
            "threshold": 0.7,
            "keep": "best_localization"
          },
          "enabled": true
        },
        {
          "id": "vehicle_box_shape",
          "op": "visual.geometry@1.0",
          "inputs": {
            "objects": "$vehicles"
          },
          "params": {
            "dimension": "aspect_ratio",
            "value": "horizontal",
            "aspect_ratio_threshold": 0.6
          },
          "enabled": true
        },
        {
          "id": "vehicles_localized",
          "op": "filter.apply@1.0",
          "inputs": {
            "objects": "$vehicles",
            "condition": "$vehicle_box_shape"
          },
          "params": {
            "output_label": null
          },
          "enabled": true
        },
        {
          "id": "lane_regions",
          "op": "region.manual_set@1.0",
          "inputs": {},
          "params": {
            "regions": []
          },
          "enabled": true
        },
        {
          "id": "vehicles_in_lanes",
          "op": "objects.filter_by_regions@1.0",
          "inputs": {
            "objects": "$vehicles_localized",
            "regions": "$lane_regions"
          },
          "params": {
            "membership_mode": "center",
            "overlap_threshold": 0.1,
            "keep": "inside"
          },
          "enabled": true
        },
        {
          "id": "lane_count",
          "op": "measure.region_count@1.0",
          "inputs": {
            "objects": "$vehicles_in_lanes",
            "regions": "$lane_regions",
            "frames": "$resized"
          },
          "params": {
            "membership_mode": "center"
          },
          "enabled": true
        },
        {
          "id": "many",
          "op": "logic.compare@1.0",
          "inputs": {
            "left": "$lane_count"
          },
          "params": {
            "operator": ">=",
            "value": 4
          },
          "enabled": true
        },
        {
          "id": "events",
          "op": "temporal.persist@1.0",
          "inputs": {
            "condition": "$many"
          },
          "params": {
            "seconds": 1.0,
            "scope": "region",
            "gap_tolerance_seconds": 0.6
          },
          "enabled": true
        },
        {
          "id": "alerts",
          "op": "output.alert@1.0",
          "inputs": {
            "events": "$events"
          },
          "params": {
            "label": "高速车辆拥堵"
          },
          "enabled": true
        },
        {
          "id": "draw",
          "op": "output.draw@1.0",
          "inputs": {
            "frames": "$resized",
            "objects": "$vehicles_in_lanes",
            "events": "$alerts",
            "regions": "$lane_regions",
            "measurements": "$lane_count"
          },
          "params": {
            "show_labels": false,
            "show_track_id": false
          },
          "enabled": true
        }
      ],
      "outputs": {
        "media": "$draw",
        "objects": "$vehicles_in_lanes",
        "events": "$alerts",
        "regions": "$lane_regions",
        "measurements_1": "$lane_count"
      },
      "atom_bindings": {
        "atom_1": [
          "lane_regions",
          "lane_count",
          "many"
        ],
        "atom_2": [
          "lane_regions",
          "vehicles_in_lanes"
        ],
        "atom_3": [
          "many",
          "events",
          "alerts"
        ]
      },
      "configuration_slots": [
        {
          "slot_id": "lane_regions",
          "kind": "region_set",
          "label": "命名车道区域",
          "required": true,
          "binding": {
            "node_id": "lane_regions",
            "parameter": "regions"
          },
          "allowed_shapes": [
            "rectangle",
            "polygon"
          ],
          "minimum_items": 1,
          "source_atom_ids": [
